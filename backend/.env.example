# Copy this file to backend/.env and fill in your keys (see README for how to
# get both keys for free).

# YouTube Data API v3 key — free, 10,000 units/day.
# Get it at https://console.cloud.google.com (enable "YouTube Data API v3").
YOUTUBE_API_KEY=

# Google Gemini API key — free tier.
# Get it at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini model to use (must be a free-tier flash model).
# The default alias always points to the current stable Flash model.
# GEMINI_MODEL=gemini-flash-latest

# Comma-separated list of allowed frontend origins for CORS.
# For local development the default already covers http://localhost:5173.
# In production set this to your Vercel URL, e.g.:
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
